# Contoh variabel lingkungan backend ynsolo.id.
#
# Salin menjadi .env lalu isi nilainya. JANGAN commit .env yang sudah berisi
# rahasia — .gitignore sudah menutup .env dan .env.prod.
#
# Berkas ini sengaja tidak memuat nilai apa pun.

# ---- Server ----
# Alamat bind Gin, mis. 0.0.0.0:8000
HOST=
# debug | release | test
GIN_MODE=

# ---- Database ----
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# ---- Sesi ----
# Kunci HMAC untuk menandatangani JWT. Pakai nilai acak yang panjang, dan
# ganti bila pernah bocor: menggantinya langsung membatalkan semua token lama.
JWT_SECRET_KEY=

# ---- Login Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# ---- Email OTP (SMTP) ----
SMTP_LOGIN=
SMTP_PASSWORD=

# ---- Keamanan web (baru di Fase 0) ----
# Origin yang boleh mengakses API, dipisah koma. Harus memuat origin aplikasi
# web yang sebenarnya. Tanpa wildcard, karena credentials diaktifkan.
# Contoh: https://ynsolo.id,https://www.ynsolo.id,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# true di produksi: cookie state OAuth hanya dikirim lewat HTTPS.
COOKIE_SECURE=

# ---- Instagram (dinding komunitas) ----
# Token Graph API jangka panjang untuk akun @yukngajisolo. HANYA dipakai di
# server: jangan pernah dikirim ke browser atau ikut masuk bundel frontend.
#
# Kosong = sinkronisasi otomatis mati. Dinding komunitas tetap tampil dengan
# postingan yang dikurasi pengurus lewat /dashboard/instagram.
#
# Token berumur sekitar 60 hari. Perpanjang dengan:
#   GET https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=<token>
# lalu salin token barunya ke sini. Langkah lengkapnya ada di
# docs/instagram-graph-api.md.
INSTAGRAM_ACCESS_TOKEN=
# ID numerik akun Instagram Bisnis @yukngajisolo (bukan nama pengguna).
INSTAGRAM_IG_USER_ID=
# Versi Graph API, mis. v21.0. Kosong berarti memakai default bawaan kode.
INSTAGRAM_GRAPH_VERSION=

# ---- ShopeePay / QRIS legacy route ----
# Kunci internal untuk route /create-qris, /check-payment, dan route mutasi.
# Kirim lewat header X-API-Key. Jangan gunakan JWT atau kunci frontend di sini.
API_KEY=
# Token sesi ShopeePay, bila masih memakai integrasi mutasi lama.
SHOPEE_TOKEN=
# Payload QRIS statis EMV. Dipakai untuk membentuk QRIS nominal dinamis.
QRIS_STATIC=
