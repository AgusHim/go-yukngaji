postgresinit:
	docker run --name mainyuk-db -p 5433:5432 -e POSTGRES_USER=root -e POSTGRES_PASSWORD=password -d postgres:alpine

postgres:
	docker exec -it mainyuk-db psql

createdb:
	docker exec -it mainyuk-db createdb --username=root --owner=root go-chat

dropdb: 
	docker exec -it mainyuk-db dropdb postgres

buildimage:
	docker build --platform linux/amd64 -t gushim/yukngaji:latest .

# Rahasia tidak lagi ditulis di berkas ini. Seluruh variabel dibaca dari
# `.env` di host saat container dijalankan; berkas itu tidak pernah ikut ke
# dalam image (lihat .dockerignore). Isi `.env` lebih dulu dengan kunci yang
# sama seperti .env.example.
runimage:
	-docker stop go-yukngaji
	-docker rm go-yukngaji
	docker run --name go-yukngaji -p 8000:8000 \
		--env-file .env \
		-e HOST=0.0.0.0:8000 \
		-e GIN_MODE=release \
		-d gushim/yukngaji:latest

# Migrasi dijalankan di dalam container yang sedang berjalan. Urutan lengkapnya
# ada di docs/deployment.md; `baseline` hanya sekali, untuk database yang
# skemanya sudah ada sebelum runner ini dipakai.
migrate-container-status:
	docker exec go-yukngaji ./migrate status

migrate-container-baseline:
	docker exec go-yukngaji ./migrate baseline

migrate-container-up:
	docker exec go-yukngaji ./migrate up

migrate-container-down:
	docker exec go-yukngaji ./migrate down -n 1

build:
	go build ./...

vet:
	go vet ./...

test:
	go test ./...

migrate-status:
	go run ./cmd/migrate status

migrate-up:
	go run ./cmd/migrate up

migrate-down:
	go run ./cmd/migrate down -n 1

migrate-baseline:
	go run ./cmd/migrate baseline

.PHONY: postgresinit postgres createdb dropdb buildimage runimage \
	build vet test migrate-status migrate-up migrate-down migrate-baseline \
	migrate-container-status migrate-container-baseline migrate-container-up \
	migrate-container-down